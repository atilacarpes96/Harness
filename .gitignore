# segredos e identidade — nunca versionar
.dsh/.credentials.yaml
.dsh/.anonymous-user-id

# estado de sessão do próprio dsh — efêmero, específico da máquina
.dsh/sessions/
.dsh/storages/
.dsh/attachments/

# dependências instaladas (reinstaláveis via pnpm)
node_modules/
.dsh/profiles/*/node_modules/

# artefatos de teste locais
screenshot.png
screenshot-tool.png

# estado local do Claude Code
.claude/

# payloads brutos capturados pelo proxy-log (grandes, regeneráveis)
harness-bench/results/requests.jsonl
