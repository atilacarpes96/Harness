lockfileVersion: '9.0'

settings:
  autoInstallPeers: false
  excludeLinksFromLockfile: false

importers:

  .:
    dependencies:
      dsh-screen-analyzer:
        specifier: file:E:/DSHARNESS/screen-tool
        version: file:../../../screen-tool

packages:

  dsh-screen-analyzer@file:../../../screen-tool:
    resolution: {directory: ../../../screen-tool, type: directory}

snapshots:

  dsh-screen-analyzer@file:../../../screen-tool: {}
