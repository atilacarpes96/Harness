agent-default-model:
  model: qwen3-vl:4b-instruct
  provider: ollama
llm-pi-ai:
  providers:
    ollama:
      baseURL: http://127.0.0.1:11434/v1
      models:
        - contextWindow: 32768
          id: qwen3-vl:4b-instruct
          input:
            - text
            - image
          maxTokens: 8192
          name: qwen3-vl:4b-instruct
        # Candidato a padrao (04/10/2026): qwen3.5:9b, mais preciso e mais lento.
        # 7,7 GB na VRAM a 64k, cabe junto com o qwen3.5:4b da visao.
        - contextWindow: 65536
          id: dsh-9b:64k
          input:
            - text
            - image
          maxTokens: 4096
          name: dsh-9b:64k (qwen3.5 9b, contexto 64k) - preciso
        # O padrao. Mesmo modelo do dsh-4b:16k com o dobro do contexto, e ainda
        # 100% na VRAM (7,9 GB de 12,3 medidos via /api/ps). Ver
        # modelfiles/dsh-4b-32k.Modelfile pra tabela de VRAM por num_ctx.
        # Gatilho 0,82 = 26.870, sobrando 5.898 acima dele pros 4096 daqui.
        - contextWindow: 32768
          id: dsh-4b:32k
          input:
            - text
            - image
          maxTokens: 4096
          name: dsh-4b:32k (4b-instruct, contexto 32k) - padrao
        # maxTokens conta DENTRO do num_ctx: prompt + resposta dividem os
        # 16384. Com 4096 aqui o gatilho de compactacao tinha de ficar em
        # 0.75 pra caber a resposta; a sessao medida chegou a 16.379/16.384.
        # As respostas reais deste agente foram de 31 a 358 tokens, entao
        # 2048 e folgado e devolve 2 mil tokens de janela util.
        - contextWindow: 16384
          id: dsh-4b:16k
          input:
            - text
            - image
          maxTokens: 2048
          name: dsh-4b:16k (4b-instruct, contexto 16k)
        # ATENCAO: as duas rotas :cloud abaixo NAO funcionam nesta conta.
        # Testado em 05/09/2026 contra /v1/chat/completions, as duas
        # respondem: "this model requires a subscription or extra usage,
        # upgrade for access at https://ollama.com/upgrade". Ficam listadas
        # para o dia em que houver assinatura; hoje escolher uma delas na UI
        # e uma sessao que falha na primeira chamada.
        - contextWindow: 1000000
          id: glm-5.2:cloud
          input:
            - text
          maxTokens: 131072
          name: glm-5.2:cloud
        - contextWindow: 524288
          id: minimax-m3:cloud
          input:
            - text
          maxTokens: 131072
          name: minimax-m3:cloud
      # NAO APAGUE `qwen3.5:4b` do Ollama. Ele nao aparece nesta lista de
      # proposito: nao e rota de agente, e o modelo de visao chamado direto
      # pelo codigo (`VISION_MODEL` em screen-tool/index.js, usado quando
      # analisar_tela recebe `visao: true`). Numa limpeza feita so por esta
      # lista ele pareceria orfao — e nao e.
      #
      # `critico-cpu`, `critico-v83-cpu`, `tradutor-cpu` e as rotas 8B sairam
      # em 04/10/2026: os workflows Flux Schnell que usavam os tres primeiros
      # perderam os modelos em 27/09. Ver harness-bench/results/.
      displayName: Ollama
      apiKeyEnv: OLLAMA_LAUNCH_DSH_API_KEY
      api: openai-completions
    nvidia:
      apiKeyEnv: NVIDIA_API_KEY
web-search-deepseek:
  apiKeyEnv: OLLAMA_LAUNCH_DSH_API_KEY
  baseURL: http://127.0.0.1:11434/v1
  model: dsh-4b:32k
agent-presets:
  default: standard
ui-onboarding:
  welcomeNoticeVersion: 2026-08-13.1
