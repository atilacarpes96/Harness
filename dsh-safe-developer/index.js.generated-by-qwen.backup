const fs = require('fs');
const path = require('path');
const { exec } = require('child_process');

module.exports = function validar_plugin_local(params) {
  const { projeto, perfil, pacote } = params;

  // 1. Verificar caminho absoluto
  if (!projeto.startsWith('E:/DSHARNESS')) {
    return { ok: false, errors: ['Caminho não está dentro de E:/DSHARNESS'] };
  }

  // 2. Validação de package.json
  try {
    const pkg = JSON.parse(fs.readFileSync(path.join(projeto, 'package.json')));
    if (pkg.name !== pacote || pkg.version !== '0.2.0') {
      return { ok: false, errors: ['Nome ou versão incompatível'] };
    }
  } catch (e) {
    return { ok: false, errors: ['package.json inválido'] };
  }

  // 3. Verificação de dependência
  const dependencyPath = path.join(projeto, 'node_modules', pacote);
  if (!fs.existsSync(dependencyPath)) {
    return { ok: false, errors: ['Dependência não encontrada'] };
  }

  // 4. Verificação de diretórios C:
  const cDriveCheck = fs.readdirSync(projeto).some(file => file.startsWith('C:\'));
  if (cDriveCheck) {
    return { ok: false, errors: ['Referência ao disco C: detectada'] };
  }

  // 5. Comparação de hashes (exemplo simplificado)
  const buffer = fs.readFileSync(path.join(projeto, 'index.js'));
  const hash = crypto.createHash('sha256').update(buffer).digest('hex');
  return { ok: true, hash: hash, versao: '0.2.0' };
}